@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<!-- Page Header -->
<div class="row" style="margin-bottom: 1.5rem;">
    <div class="col s12">
        <h4 style="font-weight: 700; color: #1a237e; display: flex; align-items: center; gap: 12px; margin: 0 0 6px 0;">
            <i class="material-icons" style="font-size: 2.4rem;">menu_book</i>
            Library Circulation & Borrower Management
        </h4>
        <p class="grey-text text-darken-1" style="font-size: 1rem; margin: 0;">
            Register borrowers, assign books, track borrowing status, and update records in real-time.
        </p>
    </div>
</div>

<!-- Card 1: Borrower & Book Form -->
<div class="card-custom">
    <div class="card-header-custom">
        <h5>
            <i class="material-icons">assignment_ind</i>
            Borrower & Book Details
        </h5>
        <div>
            <span class="chip blue-grey lighten-5 blue-grey-text text-darken-3" ng-if="!isEditing" style="font-weight: 500;">
                <i class="material-icons tiny" style="vertical-align: middle; margin-right: 4px;">add_circle</i>New Registration
            </span>
            <span class="chip amber lighten-4 amber-text text-darken-4" ng-if="isEditing" style="font-weight: 600;">
                <i class="material-icons tiny" style="vertical-align: middle; margin-right: 4px;">edit</i>Editing Record #{{editIndex + 1}}
            </span>
        </div>
    </div>

    <div class="card-content-custom">        

        <div class="row" style="margin-bottom: 0;">
            <!-- Row 1: Names -->
            <div class="input-field col s12 m4">
                <input id="firstName" type="text" class="validate" ng-model="firstName" placeholder="e.g. Juan" maxlength="50" />
                <label for="firstName" class="active">First Name *</label>
            </div>
            <div class="input-field col s12 m4">
                <input id="middleName" type="text" class="validate" ng-model="middleName" placeholder="e.g. Santos (Optional)" maxlength="50" />
                <label for="middleName" class="active">Middle Name</label>
            </div>
            <div class="input-field col s12 m4">
                <input id="lastName" type="text" class="validate" ng-model="lastName" placeholder="e.g. Dela Cruz" maxlength="50" />
                <label for="lastName" class="active">Last Name *</label>
            </div>

            <!-- Row 2: Library & Status Details -->
            <div class="input-field col s12 m6 l3">
                <input id="position" type="text" class="validate" ng-model="position" placeholder="e.g. Student / Faculty / Member" maxlength="50" />
                <label for="position" class="active">Borrower Role / Position *</label>
            </div>
            <div class="input-field col s12 m6 l3">
                <input id="bookTitle" type="text" class="validate" ng-model="bookTitle" placeholder="e.g. Noli Me Tangere" maxlength="50" />
                <label for="bookTitle" class="active">Book Title *</label>
            </div>
            <div class="input-field col s12 m6 l3">
                <input id="author" type="text" class="validate" ng-model="author" placeholder="e.g. ZYR" maxlength="50" />
                <label for="author" class="active">Author *</label>
            </div>
            <div class="col s12 m6 l3" style="margin-top: 14px;">
                <label class="active" style="font-size: 0.85rem; color: #546e7a; font-weight: 500; display: block; margin-bottom: 8px;">
                    Borrowing Status *
                </label>
                <div style="display: flex; gap: 24px; align-items: center;">
                    <label>
                        <input name="statusGroup" type="radio" ng-model="status" value="Borrowed" />
                        <span style="font-weight: 500; color: #e65100;">
                            <i class="material-icons tiny" style="vertical-align: middle; margin-right: 2px;">bookmark</i> Borrowed
                        </span>
                    </label>
                    <label>
                        <input name="statusGroup" type="radio" ng-model="status" value="Returned" />
                        <span style="font-weight: 500; color: #2e7d32;">
                            <i class="material-icons tiny" style="vertical-align: middle; margin-right: 2px;">check_circle</i> Returned
                        </span>
                    </label>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="row" style="margin-top: 2rem; margin-bottom: 0;">
            <!-- Register Borrower - shown when NOT editing -->
            <div class="col s12 m6 l4" style="margin-bottom: 12px;" ng-if="!isEditing">
                <a class="waves-effect waves-light btn-large indigo darken-3" style="width: 100%; border-radius: 8px; font-weight: 600;" ng-click="registrationFunc()">
                    <i class="material-icons left">person_add</i>
                    Register Borrower
                </a>
            </div>
            <!-- Clear - shown when NOT editing -->
            <div class="col s12 m6 l2" style="margin-bottom: 12px;" ng-if="!isEditing">
                <a class="waves-effect waves-light btn-large grey darken-1" style="width: 100%; border-radius: 8px;" ng-click="clearForm()">
                    <i class="material-icons left">backspace</i>
                    Clear
                </a>
            </div>
            <!-- Save & Update - shown when editing -->
            <div class="col s12 m8" style="margin-bottom: 12px;" ng-if="isEditing">
                <a class="waves-effect waves-light btn-large orange darken-3" style="width: 100%; border-radius: 8px; font-weight: 600;" ng-click="updateFunc()">
                    <i class="material-icons left">save</i>
                    Save &amp; Update Record
                </a>
            </div>
            <!-- Cancel - shown when editing -->
            <div class="col s12 m4" style="margin-bottom: 12px;" ng-if="isEditing">
                <a class="waves-effect waves-light btn-large grey darken-1" style="width: 100%; border-radius: 8px;" ng-click="cancelEdit()">
                    <i class="material-icons left">cancel</i>
                    Cancel
                </a>
            </div>
        </div>
        </div>
    </div>
</div>

<!-- Card 2: Registered Borrowers Table -->
<div class="card-custom">
    <div class="card-header-custom">
        <h5>
            <i class="material-icons">format_list_bulleted</i>
            Registered Library Borrowers
        </h5>
        <span class="chip blue lighten-5 blue-text text-darken-3" style="font-weight: 600;">
            Total Records: {{userarray.length}}
        </span>
    </div>

    <div class="card-content-custom" style="padding: 0;">
        <!-- Empty State Message -->
        <div class="center-align" style="padding: 3.5rem 1.5rem;" ng-if="userarray.length === 0">
            <i class="material-icons grey-text text-lighten-1" style="font-size: 4rem;">library_books</i>
            <h6 class="grey-text text-darken-1" style="margin-top: 1rem; font-weight: 600;">No Borrower Records Found</h6>
            <p class="grey-text" style="font-size: 0.95rem; margin: 6px 0 0 0;">
                Fill in the borrower details, book title, and author above, then click <strong>Register Borrower</strong> to add an entry.
            </p>
        </div>

        <!-- Table with Records -->
        <div class="responsive-table" ng-if="userarray.length > 0">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Borrower Name</th>
                        <th>Role / Position</th>
                        <th>Book Title</th>
                        <th>Author</th>
                        <th>Status</th>
                        <th class="center-align" style="width: 200px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="udata in userarray" ng-class="{'amber lighten-5': isEditing && editIndex === $index}">
                        <td><strong>{{$index + 1}}</strong></td>
                        <td>
                            <span style="font-weight: 600; color: #1a237e;">{{udata.FName}} {{udata.MName !== 'N/A' ? udata.MName : ''}} {{udata.LName}}</span>
                        </td>
                        <td>{{udata.Position}}</td>
                        <td>
                            <i class="material-icons tiny grey-text text-darken-1" style="vertical-align: middle; margin-right: 4px;">menu_book</i>
                            {{udata.BookTitle || 'General Book'}}
                        </td>
                        <td>
                            <i class="material-icons tiny grey-text text-darken-1" style="vertical-align: middle; margin-right: 4px;">person_outline</i>
                            {{udata.Author || 'N/A'}}
                        </td>
                        <td>
                            <span class="chip-status" ng-class="{'chip-returned': udata.Status === 'Returned', 'chip-borrowed': udata.Status !== 'Returned'}">
                                <i class="material-icons tiny">{{udata.Status === 'Returned' ? 'check_circle' : 'bookmark'}}</i>
                                {{udata.Status || 'Borrowed'}}
                            </span>
                        </td>
                        <td class="center-align" style="white-space: nowrap;">
                            <!-- Enhanced Edit Button -->
                            <button class="btn-action btn-action-edit" ng-click="editFunc($index)" title="Edit this record">
                                <i class="material-icons tiny">edit</i> Edit
                            </button>
                            <!-- Enhanced Delete Button -->
                            <button class="btn-action btn-action-delete" ng-click="deleteFunc($index)" title="Delete this record">
                                <i class="material-icons tiny">delete</i> Delete
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

