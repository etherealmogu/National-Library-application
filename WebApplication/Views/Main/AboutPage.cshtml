@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewBag.Title = "About - National Library System";
}

<!-- Page Title Header -->
<div class="row" style="margin-bottom: 1.5rem;">
    <div class="col s12">
        <h4 style="font-weight: 700; color: #1a237e; display: flex; align-items: center; gap: 12px; margin: 0 0 6px 0;">
            <i class="material-icons" style="font-size: 2.4rem;">info</i>
            About National Library System
        </h4>
        <p class="grey-text text-darken-1" style="font-size: 1rem; margin: 0;">
            Explore our system's purpose, modern architecture, core capabilities, and development milestones.
        </p>
    </div>
</div>

<!-- Mission & Overview Card -->
<div class="card-custom">
    <div class="card-header-custom">
        <h5>
            <i class="material-icons">flag</i>
            Application Purpose & Overview
        </h5>
        <span class="chip indigo lighten-5 indigo-text text-darken-4" style="font-weight: 600;">System Vision</span>
    </div>
    <div class="card-content-custom">
        <p style="font-size: 1.05rem; line-height: 1.8; color: #37474f;">
            The <strong>National Library & Employee Management System</strong> is an integrated web platform engineered to modernize public and institutional library operations. It unifies workforce administration with book circulation, enabling librarians and administrators to record personnel, issue reading materials, and maintain up-to-the-minute logs of borrowed and returned items.
        </p>
    </div>
</div> 
